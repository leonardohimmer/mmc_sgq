generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  name         String
  email        String        @unique
  password     String
  role         String        @default("USER")
  profileId    String?
  company      String?
  avatarUrl    String?
  emotion      String?
  lastActivity DateTime?     @db.Timestamptz(6)
  profile      Profile?      @relation(fields: [profileId], references: [id])
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  auditLogs    AuditLog[]
  testRequests TestRequest[] @relation("UserTestRequests")
}

model Document {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  code      String   @unique
  title     String
  content   String
  status    String   @default("DRAFT")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

model AuditLog {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String
  action    String
  entity    String
  entityId  String
  details   String
  ipAddress String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id])
}

model Equipment {
  id                  String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  code                String    @unique
  name                String
  manufacturer        String?
  status              String    @default("ATIVO")
  lastCalibrationDate DateTime? @db.Timestamptz(6)
  nextCalibrationDate DateTime? @db.Timestamptz(6)
  calibrationInterval Int?
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
}

model TestRequest {
  id           String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  type           String
  location       String
  contractorName      String?
  constructionCompany String?
  workName            String?
  address             String?
  proposalEmail  String?
  reportEmail    String?
  desiredDate    DateTime             @db.Timestamptz(6)
  observations   String?              @db.Text
  appliedStandard       String?
  measuredData          String?              @db.Text
  result                String?
  technicalObservations String?              @db.Text
  reportNumber          String?
  reportPdfUrl          String?
  isSigned              Boolean              @default(false)
  status       String               @default("RECEBIDO") // RECEBIDO, EM_EXECUCAO, AGUARDANDO_APROVACAO, FINALIZADO
  clientName   String
  assignedToId String?
  createdAt    DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  
  assignedTo   User?                @relation("UserTestRequests", fields: [assignedToId], references: [id])
  history      TestRequestHistory[]
}

model TestRequestHistory {
  id           String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  requestId    String
  changedBy    String
  oldStatus    String
  newStatus    String
  assignedToId String?
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)

  request      TestRequest  @relation(fields: [requestId], references: [id])
}

model Profile {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  name        String   @unique
  permissions String[]
  users       User[]
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}
